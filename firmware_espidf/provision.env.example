# Settings for build_provisioned_image.sh. Copy to provision.env, which git
# ignores. Anything left unset is read from the manager or a panel, or prompted
# for.

# Manager web address. Supplies MQTT_SERVER, MQTT_PORT and MQTT_USERNAME.
NSPM_MANAGER=http://nspanelmanager.local:8000

# Address of a panel that is already online. Supplies WIFI_SSID.
#NSPM_PANEL=192.168.1.50

# Neither the manager nor a panel will return these.
#WIFI_PSK=
#MQTT_PASSWORD=

# Override what the manager reports, e.g. if its broker address is one the
# panels cannot reach.
#WIFI_SSID=
#MQTT_SERVER=
#MQTT_PORT=1883
#MQTT_USERNAME=
